#include <iostream>

class MyVector
{
public:
	MyVector() : data(new int[1]), size_(0), capacity(1)
	{
	
	}

	~MyVector()
	{
		delete[] data;
	}

	size_t Size() const
	{
		return size_;
	}

	void PushBack(int num)
	{
		if (size_ == capacity)
		{
			size_t newCapacity = capacity * 2;
			int* newData = new int[newCapacity];
			for (size_t i = 0; i < size_; ++i)
				newData[i] = data[i];
			delete[] data;
			data = newData;
			capacity = newCapacity;
		}
		data[size_++] = num;
	}

	void Cout() const
	{
		for (size_t i = 0; i < size_; ++i)
			std::cout << data[i];
	}

private:
	int* data;
	size_t size_;
	size_t capacity;
};








int main()
{
	MyVector vec;
	vec.PushBack(1);
	vec.PushBack(1);
	vec.PushBack(1);
	std::cout << vec;
}

