#include <iostream>

class MyVector
{
public:
	size_t Size()
	{
		size_t size = sizeof(this->vec) / sizeof(this->vec[0]);
		return size;
	}

	void Cout() 
	{
		size_t size = Size();
		for (size_t i = 0; i < size; i++)
		{
			std::cout << this->vec[i];
		}
	}
	int* PushBack(int num)
	{
		size_t size = Size();
		if (size == 1)
		{
			if (this->vec[0] == NULL)
			{
				this->vec[0] = num;
			}
			else
			{
				size_t size = Size();
				int* new_vec = new int(size + 1);

				for (size_t i = 0; i < size; i++)
				{
					new_vec[i] = this->vec[i];
				}

				delete[] this->vec;
				this->vec = new_vec;

				this->vec[size] = num;
			}
		}
		else
		{
			size_t size = Size();
			int* new_vec = new int(size + 1);

			for (size_t i = 0; i < size; i++)
			{
				new_vec[i] = this->vec[i];
			}

			delete[] this->vec;
			this->vec = new_vec;

			this->vec[size] = num;
		}
		return this->vec;
	}
private:
	int* vec = new int(1);
};








int main()
{
	MyVector vec;
	vec.PushBack(1);
	vec.PushBack(1);
	vec.PushBack(1);
	vec.Cout();
}

