#include <iostream>
#include <vector>
class MyVector
{
public:
	MyVector() : data(new int[1]), size(0), capacity(1)
	{
	
	}

	~MyVector()
	{
		delete[] data;
	}

	size_t Size() const
	{
		return size;
	}



	void PushBack(int num)
	{
		if (size == capacity)
		{
			size_t newCapacity = capacity * 2;
			int* newData = new int[newCapacity];
			for (size_t i = 0; i < size; ++i)
				newData[i] = data[i];
			delete[] data;
			data = newData;
			capacity = newCapacity;
		}
		data[size++] = num;
	}

	friend std::ostream& operator <<(std::ostream& os, const MyVector& v)
	{
		os << '[';
		for (size_t i = 0; i < v.size; ++i)
		{
			if (i) os << ", ";
			os << v.data[i];
		}
		os << ']';
		return os;
	}

	void Clear()
	{
		delete[] data;

	}

private:
	int* data;
	size_t size;
	size_t capacity;
};








int main()
{
	MyVector vec;
	std::vector<int> vec2;
	vec2.push_back(123);
	vec2.clear();
	for (size_t i = 0; i < vec2.size(); i++)
	{
		std::cout << vec2[i];
	}
	
	
}

